@startuml
' Report 4: supporting interaction
title FE-04-REQUEST-CODE - Request a password reset code
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "User" as U
participant "SSFM Interface" as UI
participant "AuthController" as C
participant "AuthService" as S
participant "UsersService" as US
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "SMTP Server" as M
U -> UI : 1. Request password reset
activate UI
UI -> C : 2. Request password reset
activate C
' ref-target: PUBLIC-CHECKS
ref over C : 3. Validate request\n(PUBLIC-CHECKS)
alt 3.1 Invalid request
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Request password reset
activate S
S -> US : 5. Find account by email
activate US
US -->> S : 6. Account or none
deactivate US
opt 6.1 Account exists
S -> P : 6.1.1. Check recent reset request
activate P
P -> DB : 6.1.2. Check recent reset request
activate DB
DB -->> P : 6.1.3. Reset request history
deactivate DB
P -->> S : 6.1.4. Reset request history
deactivate P
end
opt 6.2 Account exists and resend is allowed
S -> P : 6.2.1. Save a new reset code
activate P
P -> DB : 6.2.2. Save a new reset code
activate DB
DB -->> P : 6.2.3. Reset request
deactivate DB
P -->> S : 6.2.4. Reset request
deactivate P
S -> M : 6.2.5. Email reset code
activate M
M -->> S : 6.2.6. Accepted or send error
deactivate M
opt 6.2.6.1 Email delivery fails
S -> P : 6.2.6.1.1. Remove the undelivered code
activate P
P -> DB : 6.2.6.1.2. Remove the undelivered code
activate DB
DB -->> P : 6.2.6.1.3. Code removed
deactivate DB
P -->> S : 6.2.6.1.4. Code removed
deactivate P
end
end
alt 6.3 Email delivery fails
S -->> C : 6.3.1. Reset email could not be sent
else else
S -->> C : 7. Generic response without disclosing account existence
end
deactivate S
C -->> UI : 8. Return result or error
end
deactivate C
UI -->> U : 9. Show result or error
deactivate UI
' Source references:
' backend/src/modules/auth/auth.controller.ts:28 AuthController
' backend/src/modules/auth/auth.service.ts:452 forgotPassword
' backend/src/modules/users/users.service.ts:107 findByEmail
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
