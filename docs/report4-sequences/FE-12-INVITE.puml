@startuml
' Report 4: supporting interaction
title FE-12-INVITE - Invite staff by email
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "FarmsController" as C
participant "FarmsService" as S
participant "FarmAccessService" as FA
participant "EmailService" as E
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Send staff invitation
activate UI
UI -> C : 2. Send staff invitation
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Send staff invitation
activate S
S -> FA : 5. Check farm management rights
activate FA
FA -->> S : 6. Allowed or denied
deactivate FA
alt 6.1 Access denied
S -->> C : 6.1.1. Access denied
else else
S -> P : 7. Load farm and check invited email
activate P
P -> DB : 8. Load farm and check invited email
activate DB
DB -->> P : 9. Farm and existing account or none
deactivate DB
P -->> S : 10. Farm and existing account or none
deactivate P
alt 10.1 Farm not found
S -->> C : 10.1.1. Invitation rejected
else else
alt 10.2 Account already exists
S -> P : 10.2.1. Align invited role and activate farm assignment
activate P
P -> DB : 10.2.2. Align invited role and activate farm assignment
activate DB
DB -->> P : 10.2.3. Active assignment
deactivate DB
P -->> S : 10.2.4. Active assignment
deactivate P
S -> E : 10.2.5. Email sign-in invitation
activate E
E -->> S : 10.2.6. Email attempt completed
deactivate E
S -> N : 10.2.7. Notify farm membership
activate N
N -->> S : 10.2.8. Notification result
deactivate N
opt 10.2.8.1 Newly joined and owner differs from invitee
S -> N : 10.2.8.1.1. Notify farm owner
activate N
N -->> S : 10.2.8.1.2. Notification result
deactivate N
end
else 10.3 New email
S -> E : 10.3.1. Email registration invitation
activate E
E -->> S : 10.3.2. Email attempt completed
deactivate E
end
S -->> C : 11. Invitation result
end
end
deactivate S
C -->> UI : 12. Return result or error
end
deactivate C
UI -->> U : 13. Show result or error
deactivate UI
' Source references:
' backend/src/modules/farms/farms.controller.ts:24 FarmsController
' backend/src/modules/farms/farms.service.ts:357 inviteStaffByEmail
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/email/email.service.ts:31 sendFarmInvitationExistingUser
' backend/src/modules/email/email.service.ts:136 sendFarmInvitationNewUser
' backend/src/modules/notifications/notifications.service.ts:31 createFarmJoinNotification
' backend/src/modules/notifications/notifications.service.ts:129 createStaffJoinedNotification
@enduml
