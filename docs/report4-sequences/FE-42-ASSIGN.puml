@startuml
' Report 4: supporting interaction
title FE-42-ASSIGN - Assign incident technician
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "IncidentsController" as C
participant "IncidentsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Assign a technician
activate UI
UI -> C : 2. Assign a technician
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Assign a technician
activate S
S -> P : 5. Load incident and farm
activate P
P -> DB : 6. Load incident and farm
activate DB
DB -->> P : 7. Incident or none
deactivate DB
P -->> S : 8. Incident or none
deactivate P
alt 8.1 Incident not found
S -->> C : 8.1.1. Incident not found
else else
S -> FA : 9. Check farm management rights
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
alt 10.2 Incident already resolved
S -->> C : 10.2.1. Assignment rejected
else else
S -> P : 11. Check active technician assignment to the farm
activate P
P -> DB : 12. Check active technician assignment to the farm
activate DB
DB -->> P : 13. Technician or none
deactivate DB
P -->> S : 14. Technician or none
deactivate P
alt 14.1 Technician not available in farm
S -->> C : 14.1.1. Assignment rejected
else else
S -> P : 15. Save assignment and timeline event atomically
activate P
P -> DB : 16. Save assignment and timeline event atomically
activate DB
DB -->> P : 17. Assigned incident
deactivate DB
P -->> S : 18. Assigned incident
deactivate P
S -->> C : 19. Assignment confirmation
end
end
end
end
deactivate S
C -->> UI : 20. Return result or error
end
deactivate C
UI -->> U : 21. Show result or error
deactivate UI
