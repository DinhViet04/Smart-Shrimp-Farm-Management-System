@startuml
' Report 4: 3.6.2.3
title FE-23 - Record Shrimp Health and Clinical Symptoms
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farmer / Technician" as U
participant "SSFM Interface" as UI
participant "ShrimpHealthController" as C
participant "ShrimpHealthService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit shrimp health observations
activate UI
UI -> C : 2. Submit shrimp health observations
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit shrimp health observations
activate S
alt 4.1 Observation time is in the future
S -->> C : 4.1.1. Observation time rejected
else else
S -> P : 5. Load farm, pond, crop and recorder
activate P
P -> DB : 6. Load farm, pond, crop and recorder
activate DB
DB -->> P : 7. Farming context
deactivate DB
P -->> S : 8. Farming context
deactivate P
alt 8.1 Farm not found
S -->> C : 8.1.1. Farm not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
alt 10.2 Pond or crop mismatch, or crop not active
S -->> C : 10.2.1. Health record rejected
else else
S -> P : 11. Save shrimp health observations
activate P
P -> DB : 12. Save shrimp health observations
activate DB
DB -->> P : 13. Health record
deactivate DB
P -->> S : 14. Health record
deactivate P
S -> S : 15. Start health notification task
activate S
S -->> S : 16. Task started; completion not awaited
deactivate S
note over S
Background details: HEALTH-NOTIFICATION
Completion is independent of the request response.
end note
S -->> C : 17. Health record confirmation
end
end
end
end
deactivate S
C -->> UI : 18. Return result or error
end
deactivate C
UI -->> U : 19. Show result or error
deactivate UI
