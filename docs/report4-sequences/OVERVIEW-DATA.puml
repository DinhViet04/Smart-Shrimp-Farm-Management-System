@startuml
' Report 4: supporting interaction
title OVERVIEW-DATA - Load scoped farm and pond overview
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "SSFM Interface" as UI
participant "PondsController" as C
participant "PondsService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
activate UI
UI -> C : 1. Load pond overview
activate C
' ref-target: REQUEST-CHECKS
ref over C : 2. Verify user, role and input\n(REQUEST-CHECKS)
alt 2.1 Request not allowed
C -->> UI : 2.1.1. Request rejected
else else
C -> S : 3. Load pond overview
activate S
S -> P : 4. Load farms, ponds and latest crops using direct role filters
activate P
P -> DB : 5. Load farms, ponds and latest crops using direct role filters
activate DB
DB -->> P : 6. Farm and pond overview
deactivate DB
P -->> S : 7. Farm and pond overview
deactivate P
S -->> C : 8. Overview
deactivate S
C -->> UI : 9. Return result or error
end
deactivate C
deactivate UI
' Source references:
' backend/src/modules/ponds/ponds.controller.ts:21 PondsController
' backend/src/modules/ponds/ponds.service.ts:84 findOverview
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
