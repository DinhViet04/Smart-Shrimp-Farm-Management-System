@startuml
' Report 4: supporting interaction
title FE-11-UPDATE - Update farm profile and farming model
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "FarmsController" as C
participant "FarmsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit farm changes
activate UI
UI -> C : 2. Submit farm changes
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit farm changes
activate S
S -> P : 5. Load farm
activate P
P -> DB : 6. Load farm
activate DB
DB -->> P : 7. Farm or none
deactivate DB
P -->> S : 8. Farm or none
deactivate P
alt 8.1 Farm not found
S -->> C : 8.1.1. Farm not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -> FA : 11. Check farm management rights
activate FA
FA -->> S : 12. Allowed or denied
deactivate FA
alt 12.1 Access denied
S -->> C : 12.1.1. Access denied
else else
S -> P : 13. Check name and total pond area
activate P
P -> DB : 14. Check name and total pond area
activate DB
DB -->> P : 15. Existing names and occupied area
deactivate DB
P -->> S : 16. Existing names and occupied area
deactivate P
alt 16.1 Duplicate name or farm area too small
S -->> C : 16.1.1. Farm changes rejected
else else
S -> P : 17. Save farm changes
activate P
P -> DB : 18. Save farm changes
activate DB
DB -->> P : 19. Updated farm
deactivate DB
P -->> S : 20. Updated farm
deactivate P
opt 20.1 Staff list supplied
S -> P : 20.1.1. Replace farm staff assignments
activate P
P -> DB : 20.1.2. Replace farm staff assignments
activate DB
DB -->> P : 20.1.3. Updated assignments
deactivate DB
P -->> S : 20.1.4. Updated assignments
deactivate P
end
S -->> C : 21. Updated farm
end
end
end
end
deactivate S
C -->> UI : 22. Return result or error
end
deactivate C
UI -->> U : 23. Show result or error
deactivate UI
' Source references:
' backend/src/modules/farms/farms.controller.ts:24 FarmsController
' backend/src/modules/farms/farms.service.ts:154 update
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
@enduml
