@startuml
' Report 4: 3.6.2.4
title FE-24 - Record Daily Farming Notes and Operational Observations
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farmer / Farm Manager" as U
participant "SSFM Interface" as UI
participant "DailyNotesController\n(proposed)" as C
participant "DailyNotesService\n(proposed)" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
caption Proposed design - target design, not a claim of complete implementation
U -> UI : 1. Submit daily farming note
activate UI
UI -> C : 2. Submit daily farming note
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit daily farming note
activate S
note over S
Proposed extension: Independent daily notes.
end note
S -> FA : 5. Check farm access
activate FA
FA -->> S : 6. Allowed or denied
deactivate FA
alt 6.1 Access denied
S -->> C : 6.1.1. Access denied
else else
S -> P : 7. Check selected farm, pond and crop
activate P
P -> DB : 8. Check selected farm, pond and crop
activate DB
DB -->> P : 9. Farming context
deactivate DB
P -->> S : 10. Farming context
deactivate P
alt 10.1 Selected context invalid
S -->> C : 10.1.1. Daily note rejected
else else
S -> P : 11. Save daily note and observations
activate P
P -> DB : 12. Save daily note and observations
activate DB
DB -->> P : 13. Daily note
deactivate DB
P -->> S : 14. Daily note
deactivate P
S -->> C : 15. Daily note confirmation
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
