@startuml
' Report 4: supporting interaction
title INCIDENT-FILTERS - Resolve incident season and farm filters
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "IncidentsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
opt 1.1 Farm selected
S -> FA : 1.1.1. Check farm access
activate FA
FA -->> S : 1.1.2. Allowed or denied
deactivate FA
end
end
opt 1.2 Pond selected
S -> P : 1.2.1. Load selected pond
activate P
P -> DB : 1.2.2. Load selected pond
activate DB
DB -->> P : 1.2.3. Pond or none
deactivate DB
P -->> S : 1.2.4. Pond or none
deactivate P
opt 1.2.4.1 Pond exists
S -> FA : 1.2.4.1.1. Check farm access
activate FA
FA -->> S : 1.2.4.1.2. Allowed or denied
deactivate FA
end
end
opt 1.3 Crop selected
S -> P : 1.3.1. Load crop and farm
activate P
P -> DB : 1.3.2. Load crop and farm
activate DB
DB -->> P : 1.3.3. Crop or none
deactivate DB
P -->> S : 1.3.4. Crop or none
deactivate P
opt 1.3.4.1 Crop exists
S -> FA : 1.3.4.1.1. Check farm access
activate FA
FA -->> S : 1.3.4.1.2. Allowed or denied
deactivate FA
opt 1.3.4.1.2.1 Access allowed
S -> P : 1.3.4.1.2.1.1. Load root and child crop IDs
activate P
P -> DB : 1.3.4.1.2.1.2. Load root and child crop IDs
activate DB
DB -->> P : 1.3.4.1.2.1.3. Season crop IDs
deactivate DB
P -->> S : 1.3.4.1.2.1.4. Season crop IDs
deactivate P
end
end
end
deactivate S
' Source references:
' backend/src/modules/incidents/incidents.service.ts:26 findAll
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
