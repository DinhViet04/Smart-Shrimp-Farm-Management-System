@startuml
' Report 4: supporting interaction
title FE-14-DELETE - Delete pond
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager / Admin" as U
participant "SSFM Interface" as UI
participant "PondsController" as C
participant "PondsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Confirm pond deletion
activate UI
UI -> C : 2. Confirm pond deletion
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Confirm pond deletion
activate S
S -> P : 5. Load selected pond
activate P
P -> DB : 6. Load selected pond
activate DB
DB -->> P : 7. Pond or not found
deactivate DB
P -->> S : 8. Pond or not found
deactivate P
alt 8.1 Pond not found
S -->> C : 8.1.1. Pond not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -> FA : 11. Check farm management rights
activate FA
FA -->> S : 12. Allowed or denied
deactivate FA
alt 12.1 Access denied
S -->> C : 12.1.1. Access denied
else else
S -> P : 13. Delete selected pond
activate P
P -> DB : 14. Delete selected pond
activate DB
DB -->> P : 15. Pond deleted
deactivate DB
P -->> S : 16. Pond deleted
deactivate P
S -->> C : 17. Deletion confirmation
end
end
end
deactivate S
C -->> UI : 18. Return result or error
end
deactivate C
UI -->> U : 19. Show result or error
deactivate UI
' Source references:
' backend/src/modules/ponds/ponds.controller.ts:21 PondsController
' backend/src/modules/ponds/ponds.service.ts:255 remove
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
@enduml
