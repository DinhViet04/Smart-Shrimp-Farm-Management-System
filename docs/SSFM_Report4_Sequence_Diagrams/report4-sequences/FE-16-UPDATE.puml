@startuml
' Report 4: supporting interaction
title FE-16-UPDATE - Update crop
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager / Farmer" as U
participant "SSFM Interface" as UI
participant "CropsController" as C
participant "CropsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit crop changes
activate UI
UI -> C : 2. Submit crop changes
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit crop changes
activate S
S -> P : 5. Load crop and pond
activate P
P -> DB : 6. Load crop and pond
activate DB
DB -->> P : 7. Crop or not found
deactivate DB
P -->> S : 8. Crop or not found
deactivate P
alt 8.1 Crop not found
S -->> C : 8.1.1. Crop not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
opt 10.2 Changing crop to active
S -> P : 10.2.1. Find another active crop in the pond
activate P
P -> DB : 10.2.2. Find another active crop in the pond
activate DB
DB -->> P : 10.2.3. Competing crop or none
deactivate DB
P -->> S : 10.2.4. Competing crop or none
deactivate P
end
alt 10.3 Competing crop or invalid crop details
S -->> C : 10.3.1. Crop changes rejected
else else
S -> P : 11. Save crop changes
activate P
P -> DB : 12. Save crop changes
activate DB
DB -->> P : 13. Updated crop
deactivate DB
P -->> S : 14. Updated crop
deactivate P
S -->> C : 15. Updated crop
end
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
' Source references:
' backend/src/modules/crops/crops.controller.ts:27 CropsController
' backend/src/modules/crops/crops.service.ts:533 update
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
@enduml
