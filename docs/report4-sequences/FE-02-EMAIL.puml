@startuml
' Report 4: supporting interaction
title FE-02-EMAIL - Sign in with email and password
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "User" as U
participant "SSFM Interface" as UI
participant "AuthController" as C
participant "AuthService" as S
participant "UsersService" as US
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit email and password
activate UI
UI -> C : 2. Submit email and password
activate C
' ref-target: PUBLIC-CHECKS
ref over C : 3. Validate request\n(PUBLIC-CHECKS)
alt 3.1 Invalid request
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit email and password
activate S
S -> US : 5. Find account
activate US
US -->> S : 6. Account or not found
deactivate US
alt 6.1 Account missing, locked or credentials incorrect
S -->> C : 6.1.1. Sign-in rejected
else else
opt 6.2 Invitation supplied
' ref-target: JOIN-FARM
ref over S : 6.2.1. Validate invitation and join farm\n(JOIN-FARM)
end
alt 6.3 Invitation details invalid
S -->> C : 6.3.1. Invitation rejected
else else
S -> P : 7. Create sign-in session
activate P
P -> DB : 8. Create sign-in session
activate DB
DB -->> P : 9. Sign-in session
deactivate DB
P -->> S : 10. Sign-in session
deactivate P
S -->> C : 11. Signed-in user
end
end
deactivate S
C -->> UI : 12. Return result or error
end
deactivate C
UI -->> U : 13. Show sign-in result
deactivate UI
' Source references:
' backend/src/modules/auth/auth.controller.ts:28 AuthController
' backend/src/modules/auth/auth.service.ts:173 login
' backend/src/modules/users/users.service.ts:107 findByEmail
' backend/src/modules/auth/auth.service.ts:820 generateTokens
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
