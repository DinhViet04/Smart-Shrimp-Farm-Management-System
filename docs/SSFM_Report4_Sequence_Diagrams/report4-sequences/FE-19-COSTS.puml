@startuml
' Report 4: supporting interaction
title FE-19-COSTS - Load suggested harvest costs
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager / Admin / Farmer" as U
participant "SSFM Interface" as UI
participant "CropsController" as C
participant "CropsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Review harvest cost suggestions
activate UI
UI -> C : 2. Review harvest cost suggestions
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Review harvest cost suggestions
activate S
S -> P : 5. Load crop and pond
activate P
P -> DB : 6. Load crop and pond
activate DB
DB -->> P : 7. Crop or not found
deactivate DB
P -->> S : 8. Crop or not found
deactivate P
alt 8.1 Crop not found
S -->> C : 8.1.1. Crop not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -> P : 11. Load feeding, material usage and prices
activate P
P -> DB : 12. Load feeding, material usage and prices
activate DB
DB -->> P : 13. Suggested feed and material costs
deactivate DB
P -->> S : 14. Suggested feed and material costs
deactivate P
S -->> C : 15. Harvest cost suggestions
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
' Source references:
' backend/src/modules/crops/crops.controller.ts:27 CropsController
' backend/src/modules/crops/crops.service.ts:740 getHarvestSummary
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
@enduml
