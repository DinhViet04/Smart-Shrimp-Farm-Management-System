@startuml
' Report 4: supporting interaction
title WATER-HISTORY-FILTERS - Select water history scope
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "WaterQualityService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
alt 1.1 Crop selected
S -> P : 1.1.1. Load crop and linked season ponds
activate P
P -> DB : 1.1.2. Load crop and linked season ponds
activate DB
DB -->> P : 1.1.3. Crop or none
deactivate DB
P -->> S : 1.1.4. Crop or none
deactivate P
opt 1.1.4.1 Crop exists
S -> FA : 1.1.4.1.1. Check farm access
activate FA
FA -->> S : 1.1.4.1.2. Allowed or denied
deactivate FA
end
else 1.2 Pond selected without crop
S -> P : 1.2.1. Load pond
activate P
P -> DB : 1.2.2. Load pond
activate DB
DB -->> P : 1.2.3. Pond or none
deactivate DB
P -->> S : 1.2.4. Pond or none
deactivate P
opt 1.2.4.1 Pond exists
S -> FA : 1.2.4.1.1. Check farm access
activate FA
FA -->> S : 1.2.4.1.2. Allowed or denied
deactivate FA
end
else 1.3 Farm selected without pond or crop
S -> P : 1.3.1. Load farm
activate P
P -> DB : 1.3.2. Load farm
activate DB
DB -->> P : 1.3.3. Farm or none
deactivate DB
P -->> S : 1.3.4. Farm or none
deactivate P
opt 1.3.4.1 Farm exists
S -> FA : 1.3.4.1.1. Check farm access
activate FA
FA -->> S : 1.3.4.1.2. Allowed or denied
deactivate FA
end
else 1.4 No specific selection
note over S
Use accessible farm IDs already obtained by the caller.
end note
end
end
note over S
Missing selected records or denied access return an error.
Allowed selections define the period and pagination.
end note
deactivate S
' Source references:
' backend/src/modules/water-quality/water-quality.service.ts:206 findHistory
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
