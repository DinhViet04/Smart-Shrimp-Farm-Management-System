@startuml
' Report 4: 3.16.2.2
title FE-57 - Export Analytical Reports and Historical Logs as PDF, Excel, or CSV
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "CropsController" as C
participant "CropsService" as S
participant "FarmAccessService" as FA
participant "Report Exporter\n(proposed)" as EXPORT
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "Print Dialog" as PRINT
caption Existing + proposed extension - target design, not a claim of complete implementation
U -> UI : 1. Load report for export
activate UI
UI -> C : 2. Load report for export
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Load report for export
activate S
S -> P : 5. Load crop and pond
activate P
P -> DB : 6. Load crop and pond
activate DB
DB -->> P : 7. Crop or not found
deactivate DB
P -->> S : 8. Crop or not found
deactivate P
alt 8.1 Crop not found
S -->> C : 8.1.1. Crop not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -> P : 11. Load crop records and costs
activate P
P -> DB : 12. Load crop records and costs
activate DB
DB -->> P : 13. Feeding, water, samples, health, incidents, materials and mortality
deactivate DB
P -->> S : 14. Feeding, water, samples, health, incidents, materials and mortality
deactivate P
S -->> C : 15. Detailed report
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
U -> UI : 18. Choose export format
activate UI
alt 18.1 PDF
UI -> PRINT : 18.1.1. Open report printing
activate PRINT
PRINT -->> UI : 18.1.2. Print dialog closed
deactivate PRINT
else 18.2 Excel or CSV
note over S
Proposed extension: Spreadsheet and CSV export.
end note
UI -> EXPORT : 18.2.1. Create selected report file
activate EXPORT
EXPORT -->> UI : 18.2.2. Downloadable file
deactivate EXPORT
end
UI -->> U : 19. Show print result or downloaded file
deactivate UI
