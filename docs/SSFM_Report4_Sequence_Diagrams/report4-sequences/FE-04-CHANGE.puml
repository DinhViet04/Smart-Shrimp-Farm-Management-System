@startuml
' Report 4: supporting interaction
title FE-04-CHANGE - Change password while signed in
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Signed-in User" as U
participant "SSFM Interface" as UI
participant "UsersController" as C
participant "UsersService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "SMTP Server" as M
U -> UI : 1. Submit password change
activate UI
UI -> C : 2. Submit password change
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit password change
activate S
S -> P : 5. Load account
activate P
P -> DB : 6. Load account
activate DB
DB -->> P : 7. Account and password status
deactivate DB
P -->> S : 8. Account and password status
deactivate P
alt 8.1 Account missing or passwords invalid
S -->> C : 8.1.1. Password change rejected
else else
S -> P : 9. Save new password
activate P
P -> DB : 10. Save new password
activate DB
DB -->> P : 11. Password updated
deactivate DB
P -->> S : 12. Password updated
deactivate P
S -> P : 13. Revoke existing refresh sessions
activate P
P -> DB : 14. Revoke existing refresh sessions
activate DB
DB -->> P : 15. Sessions ended
deactivate DB
P -->> S : 16. Sessions ended
deactivate P
opt 16.1 Email configured
S -> M : 16.1.1. Send password change notice
activate M
M -->> S : 16.1.2. Sent or error caught
deactivate M
end
S -->> C : 17. Password changed
end
deactivate S
C -->> UI : 18. Return result or error
end
deactivate C
UI -->> U : 19. Show confirmation and request sign-in
deactivate UI
' Source references:
' backend/src/modules/users/users.controller.ts:22 UsersController
' backend/src/modules/users/users.service.ts:233 changePassword
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
