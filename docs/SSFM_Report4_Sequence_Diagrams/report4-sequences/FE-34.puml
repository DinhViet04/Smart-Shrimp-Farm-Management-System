@startuml
' Report 4: 3.9.2.3
title FE-34 - Monitor Survival Rate and Remaining Shrimp Population
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "SurvivalRateController" as C
participant "SurvivalRateService" as S
participant "FarmAccessService" as FA
participant "ShrimpSizeService" as SS
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. View crop survival and population
activate UI
UI -> C : 2. View crop survival and population
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. View crop survival and population
activate S
S -> P : 5. Load crop and pond
activate P
P -> DB : 6. Load crop and pond
activate DB
DB -->> P : 7. Crop or not found
deactivate DB
P -->> S : 8. Crop or not found
deactivate P
alt 8.1 Crop not found
S -->> C : 8.1.1. Crop not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
alt 10.2 Stocking count missing or zero
S -->> C : 10.2.1. Survival cannot be calculated
else else
S -> SS : 11. Load latest population estimate
activate SS
SS -->> S : 12. Estimate or none
deactivate SS
alt 12.1 Harvest count available
note over S
Use the recorded harvested population.
end note
else 12.2 No harvest but sample estimate available
note over S
Use the latest sample estimate.
end note
else 12.3 No estimate available
note over S
Use initial stocking count.
end note
end
S -->> C : 13. Population, survival rate and comparison with target
end
end
end
deactivate S
C -->> UI : 14. Return result or error
end
deactivate C
UI -->> U : 15. Show result or error
deactivate UI
' Source references:
' backend/src/modules/survival-rate/survival-rate.controller.ts:22 SurvivalRateController
' backend/src/modules/survival-rate/survival-rate.service.ts:31 calculateSurvivalRate
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
' backend/src/modules/shrimp-size/shrimp-size.service.ts:358 getCurrentShrimpCount
@enduml
