# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# PostgreSQL
# On a VPS these may be identical. With a managed provider, DATABASE_URL can
# use the connection pool while DIRECT_URL must connect directly for migrations.
DATABASE_URL=postgresql://ssfm:CHANGE_ME@postgres:5432/ssfm?schema=public
DIRECT_URL=postgresql://ssfm:CHANGE_ME@postgres:5432/ssfm?schema=public

# Authentication - generate two different random values of at least 32 chars.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Public web origins (no trailing slash)
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Google Identity Services - same value as frontend-web VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# SMTP - required for invitations and password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=USE_AN_APP_PASSWORD
SMTP_FROM="SSFM <noreply@example.com>"

# Optional AI/weather integrations. Leave blank to use local fallback behavior.
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
AI_SERVICE_URL=http://ai-service:8000

# Used only by `npm run db:seed`; remove from the runtime environment afterward.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=GENERATE_A_STRONG_BOOTSTRAP_PASSWORD
SEED_ADMIN_NAME=System Administrator
