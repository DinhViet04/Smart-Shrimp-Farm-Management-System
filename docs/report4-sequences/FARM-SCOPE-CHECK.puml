@startuml
' Report 4: supporting interaction
title FARM-SCOPE-CHECK - Check farm access scope
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "FarmAccessService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
alt 1.1 Admin
note over S
Farm scope is unrestricted.
end note
else 1.2 Farm Manager
S -> P : 1.2.1. Load owned, active farm
activate P
P -> DB : 1.2.2. Load owned, active farm
activate DB
DB -->> P : 1.2.3. Owned farm or none
deactivate DB
P -->> S : 1.2.4. Owned farm or none
deactivate P
else 1.3 Assigned Farmer or Technician
S -> P : 1.3.1. Load active farm assignments
activate P
P -> DB : 1.3.2. Load active farm assignments
activate DB
DB -->> P : 1.3.3. Assigned farms
deactivate DB
P -->> S : 1.3.4. Assigned farms
deactivate P
end
end
deactivate S
' Source references:
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
