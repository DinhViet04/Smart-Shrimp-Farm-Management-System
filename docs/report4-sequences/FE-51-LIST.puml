@startuml
' Report 4: supporting interaction
title FE-51-LIST - View and filter own notifications
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "User" as U
participant "SSFM Interface" as UI
participant "NotificationsController" as C
participant "NotificationsService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. View notifications
activate UI
UI -> C : 2. View notifications
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. View notifications
activate S
S -> P : 5. Load own recent notifications and pond names
activate P
P -> DB : 6. Load own recent notifications and pond names
activate DB
DB -->> P : 7. Notifications
deactivate DB
P -->> S : 8. Notifications
deactivate P
S -->> C : 9. Notification list
deactivate S
C -->> UI : 10. Return result or error
end
deactivate C
UI -->> U : 11. Show notifications and apply selected severity filter
deactivate UI
' Source references:
' backend/src/modules/notifications/notifications.controller.ts:15 NotificationsController
' backend/src/modules/notifications/notifications.service.ts:484 getUserNotifications
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
