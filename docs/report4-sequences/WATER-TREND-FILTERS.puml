@startuml
' Report 4: supporting interaction
title WATER-TREND-FILTERS - Select water trend scope
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "WaterQualityService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
alt 1.1 Single pond selected
S -> P : 1.1.1. Load selected pond
activate P
P -> DB : 1.1.2. Load selected pond
activate DB
DB -->> P : 1.1.3. Pond or none
deactivate DB
P -->> S : 1.1.4. Pond or none
deactivate P
opt 1.1.4.1 Pond exists
S -> FA : 1.1.4.1.1. Check farm access
activate FA
FA -->> S : 1.1.4.1.2. Allowed or denied
deactivate FA
end
else 1.2 Crop selected without single pond
S -> P : 1.2.1. Load crop and linked season
activate P
P -> DB : 1.2.2. Load crop and linked season
activate DB
DB -->> P : 1.2.3. Crop or none
deactivate DB
P -->> S : 1.2.4. Crop or none
deactivate P
opt 1.2.4.1 Crop exists
S -> FA : 1.2.4.1.1. Check farm access
activate FA
FA -->> S : 1.2.4.1.2. Allowed or denied
deactivate FA
end
else 1.3 Farm selected without pond or crop
S -> FA : 1.3.1. Check farm access
activate FA
FA -->> S : 1.3.2. Allowed or denied
deactivate FA
else 1.4 No selected scope
S -> FA : 1.4.1. Find accessible farms
activate FA
FA -->> S : 1.4.2. Accessible farms
deactivate FA
end
end
opt 1.5 Crop selected
S -> P : 1.5.1. Load crop dates and season links
activate P
P -> DB : 1.5.2. Load crop dates and season links
activate DB
DB -->> P : 1.5.3. Time window or none
deactivate DB
P -->> S : 1.5.4. Time window or none
deactivate P
end
deactivate S
' Source references:
' backend/src/modules/water-quality/water-quality.service.ts:406 findTrends
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
