@startuml
' Report 4: supporting interaction
title FE-43-VIEW - View incident treatment timeline
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "IncidentsController" as C
participant "IncidentsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Open incident timeline
activate UI
UI -> C : 2. Open incident timeline
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Open incident timeline
activate S
S -> P : 5. Load incident and ordered treatment updates
activate P
P -> DB : 6. Load incident and ordered treatment updates
activate DB
DB -->> P : 7. Incident or none
deactivate DB
P -->> S : 8. Incident or none
deactivate P
alt 8.1 Incident not found
S -->> C : 8.1.1. Incident not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -->> C : 11. Incident timeline
end
end
deactivate S
C -->> UI : 12. Return result or error
end
deactivate C
UI -->> U : 13. Show result or error
deactivate UI
' Source references:
' backend/src/modules/incidents/incidents.controller.ts:27 IncidentsController
' backend/src/modules/incidents/incidents.service.ts:131 findOne
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
@enduml
