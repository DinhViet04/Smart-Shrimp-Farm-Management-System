@startuml
' Report 4: supporting interaction
title FE-14-CREATE - Create pond
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager / Admin" as U
participant "SSFM Interface" as UI
participant "PondsController" as C
participant "PondsService" as S
participant "FarmAccessService" as FA
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit pond details
activate UI
UI -> C : 2. Submit pond details
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit pond details
activate S
S -> FA : 5. Check farm management rights
activate FA
FA -->> S : 6. Allowed or denied
deactivate FA
alt 6.1 Access denied
S -->> C : 6.1.1. Access denied
else else
S -> P : 7. Load farm and occupied pond area
activate P
P -> DB : 8. Load farm and occupied pond area
activate DB
DB -->> P : 9. Farm and existing pond area
deactivate DB
P -->> S : 10. Farm and existing pond area
deactivate P
alt 10.1 Farm missing or available area insufficient
S -->> C : 10.1.1. Pond creation rejected
else else
S -> P : 11. Save pond and farm association
activate P
P -> DB : 12. Save pond and farm association
activate DB
DB -->> P : 13. New pond
deactivate DB
P -->> S : 14. New pond
deactivate P
opt 14.1 Creator is a Farm Manager
S -> N : 14.1.1. Notify pond creation
activate N
N -->> S : 14.1.2. Notification result
deactivate N
end
S -->> C : 15. New pond
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
' Source references:
' backend/src/modules/ponds/ponds.controller.ts:21 PondsController
' backend/src/modules/ponds/ponds.service.ts:22 create
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/notifications/notifications.service.ts:187 createPondCreatedNotification
@enduml
