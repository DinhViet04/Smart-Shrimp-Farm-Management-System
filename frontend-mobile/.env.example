# API Backend URL
# For Android Emulator: http://10.0.2.2:3000
# For Physical Device (LAN): http://<YOUR_LOCAL_IP>:3000 (e.g., http://192.168.1.15:3000)
# For Production: https://api.yourdomain.com
# Local development:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Production APK/AAB (use this value in the EAS production environment):
# EXPO_PUBLIC_API_URL=https://api.example.com
