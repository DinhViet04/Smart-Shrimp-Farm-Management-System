@startuml
' Report 4: supporting interaction
title FE-02-GOOGLE - Sign in with Google
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "User" as U
participant "SSFM Interface" as UI
participant "AuthController" as C
participant "AuthService" as S
participant "UsersService" as US
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "Google Identity" as G
U -> UI : 1. Choose Google sign-in
activate UI
UI -> C : 2. Choose Google sign-in
activate C
' ref-target: PUBLIC-CHECKS
ref over C : 3. Validate request\n(PUBLIC-CHECKS)
alt 3.1 Invalid request
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Choose Google sign-in
activate S
S -> G : 5. Verify Google identity
activate G
G -->> S : 6. Verified identity or error
deactivate G
alt 6.1 Google identity invalid or email unverified
S -->> C : 6.1.1. Google sign-in rejected
else else
S -> US : 7. Find account by email
activate US
US -->> S : 8. Account or none
deactivate US
alt 8.1 Existing account
S -> US : 8.1.1. Link Google identity if needed
activate US
US -->> S : 8.1.2. Linked account
deactivate US
else 8.2 New account
S -> US : 8.2.1. Create Google-linked account
activate US
US -->> S : 8.2.2. New account
deactivate US
S -> N : 8.2.3. Send welcome notification
activate N
N -->> S : 8.2.4. Notification result
deactivate N
end
alt 8.3 Account locked
S -->> C : 8.3.1. Sign-in rejected
else else
opt 8.4 Invitation supplied
' ref-target: JOIN-FARM
ref over S : 8.4.1. Process invitation; Google invitation errors are caught\n(JOIN-FARM)
end
S -> P : 9. Create sign-in session
activate P
P -> DB : 10. Create sign-in session
activate DB
DB -->> P : 11. Sign-in session
deactivate DB
P -->> S : 12. Sign-in session
deactivate P
S -->> C : 13. Signed-in user
end
end
deactivate S
C -->> UI : 14. Return result or error
end
deactivate C
UI -->> U : 15. Show result or error
deactivate UI
' Source references:
' backend/src/modules/auth/auth.controller.ts:28 AuthController
' backend/src/modules/auth/auth.service.ts:298 loginWithGoogle
' backend/src/modules/users/users.service.ts:107 findByEmail
' backend/src/modules/notifications/notifications.service.ts:13 createWelcomeNotification
' backend/src/modules/auth/auth.service.ts:820 generateTokens
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
