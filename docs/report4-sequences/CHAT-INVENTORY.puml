@startuml
' Report 4: supporting interaction
title CHAT-INVENTORY - Prepare authorized inventory context for advice
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "ChatbotService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
opt 1.1 Pond context identifies a farm
S -> P : 1.1.1. Load the pond farm association
activate P
P -> DB : 1.1.2. Load the pond farm association
activate DB
DB -->> P : 1.1.3. Target farm
deactivate DB
P -->> S : 1.1.4. Target farm
deactivate P
end
end
opt 1.2 No target farm yet
S -> FA : 1.2.1. Find accessible farms
activate FA
FA -->> S : 1.2.2. Accessible farms
deactivate FA
opt 1.2.2.1 No accessible farm found
S -> P : 1.2.2.1.1. Find farm owned by or assigned to user
activate P
P -> DB : 1.2.2.1.2. Find farm owned by or assigned to user
activate DB
DB -->> P : 1.2.2.1.3. User farm or none
deactivate DB
P -->> S : 1.2.2.1.4. User farm or none
deactivate P
end
end
opt 1.3 Target farm found
S -> P : 1.3.1. Load available medicines and chemicals
activate P
P -> DB : 1.3.2. Load available medicines and chemicals
activate DB
DB -->> P : 1.3.3. Inventory context
deactivate DB
P -->> S : 1.3.4. Inventory context
deactivate P
end
deactivate S
' Source references:
' backend/src/modules/chatbot/chatbot.service.ts:327 ask
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
