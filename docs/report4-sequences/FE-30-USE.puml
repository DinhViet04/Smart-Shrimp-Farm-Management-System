@startuml
' Report 4: supporting interaction
title FE-30-USE - Record material usage
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "InventoryController" as C
participant "InventoryService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit material usage
activate UI
UI -> C : 2. Submit material usage
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit material usage
activate S
S -> P : 5. Load inventory item
activate P
P -> DB : 6. Load inventory item
activate DB
DB -->> P : 7. Item and stock
deactivate DB
P -->> S : 8. Item and stock
deactivate P
alt 8.1 Item not found
S -->> C : 8.1.1. Item not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
alt 10.2 Requested quantity exceeds stock
S -->> C : 10.2.1. Usage rejected
else else
S -> P : 11. Save usage and reduce stock atomically
activate P
P -> DB : 12. Save usage and reduce stock atomically
activate DB
DB -->> P : 13. Usage record and remaining stock
deactivate DB
P -->> S : 14. Usage record and remaining stock
deactivate P
S -->> C : 15. Usage confirmation
end
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
' Source references:
' backend/src/modules/inventory/inventory.controller.ts:25 InventoryController
' backend/src/modules/inventory/inventory.service.ts:125 recordUsage
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
@enduml
