# Docker Compose project
COMPOSE_PROJECT_NAME=ssfm
HTTP_PORT=80

# PostgreSQL container (never commit the real password)
POSTGRES_DB=ssfm
POSTGRES_USER=ssfm
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://ssfm:URL_ENCODED_DATABASE_PASSWORD@postgres:5432/ssfm?schema=public
DIRECT_URL=postgresql://ssfm:URL_ENCODED_DATABASE_PASSWORD@postgres:5432/ssfm?schema=public

# Backend
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=USE_AN_APP_PASSWORD
SMTP_FROM=SSFM <noreply@example.com>

# Optional integrations
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
AI_CORS_ORIGINS=["https://app.example.com"]
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
AUTO_SYNC_DRIVE_ON_STARTUP=false

# Frontend build (normally the same public origin used to open the web app)
VITE_API_URL=https://app.example.com
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# One-time bootstrap Admin (`--profile seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=GENERATE_A_STRONG_BOOTSTRAP_PASSWORD
SEED_ADMIN_NAME=System Administrator
