@startuml
' Report 4: supporting interaction
title FE-48-INGEST - Create and ingest a knowledge document
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Admin / Farm Manager / Technician" as U
participant "SSFM Interface" as UI
participant "ChatbotController" as C
participant "ChatbotService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "FastAPI AI Service" as AI
caption Existing + proposed extension - target design, not a claim of complete implementation
U -> UI : 1. Submit knowledge document
activate UI
UI -> C : 2. Submit knowledge document
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit knowledge document
activate S
S -> P : 5. Save source document
activate P
P -> DB : 6. Save source document
activate DB
DB -->> P : 7. Knowledge document
deactivate DB
P -->> S : 8. Knowledge document
deactivate P
note over S
Proposed extension: Unified AI knowledge ingestion.
end note
S -> AI : 9. Extract, divide and index document text
activate AI
' ref-target: KNOWLEDGE-INDEX
ref over AI : 10. Build the planned searchable knowledge store\n(KNOWLEDGE-INDEX)
AI -->> S : 11. Indexing result
deactivate AI
alt 11.1 Proposed AI indexing fails
S -->> C : 11.1.1. Document saved; indexing incomplete
else else
S -->> C : 12. Document and indexing status
end
deactivate S
C -->> UI : 13. Return result or error
end
deactivate C
UI -->> U : 14. Show result or error
deactivate UI
' Source references:
' backend/src/modules/chatbot/chatbot.controller.ts:21 ChatbotController
' backend/src/modules/chatbot/chatbot.service.ts:160 createDocument
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
