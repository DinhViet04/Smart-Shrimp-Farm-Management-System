@startuml
' Report 4: supporting interaction
title GROWTH-SCOPE - Resolve growth analysis scope
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "CropsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
opt 1.1 No selected farm and no accessible farm ID
S -> P : 1.1.1. Find first available farm
activate P
P -> DB : 1.1.2. Find first available farm
activate DB
DB -->> P : 1.1.3. Farm or none
deactivate DB
P -->> S : 1.1.4. Farm or none
deactivate P
end
end
opt 1.2 Target farm available
S -> FA : 1.2.1. Check farm access
activate FA
FA -->> S : 1.2.2. Allowed or denied
deactivate FA
opt 1.2.2.1 Access allowed
S -> P : 1.2.2.1.1. Load target farm
activate P
P -> DB : 1.2.2.1.2. Load target farm
activate DB
DB -->> P : 1.2.2.1.3. Farm details
deactivate DB
P -->> S : 1.2.2.1.4. Farm details
deactivate P
opt 1.2.2.1.4.1 Specific pond selected
S -> P : 1.2.2.1.4.1.1. Load pond
activate P
P -> DB : 1.2.2.1.4.1.2. Load pond
activate DB
DB -->> P : 1.2.2.1.4.1.3. Pond or none
deactivate DB
P -->> S : 1.2.2.1.4.1.4. Pond or none
deactivate P
opt 1.2.2.1.4.1.4.1 Pond exists
S -> P : 1.2.2.1.4.1.4.1.1. Find crop for selected pond and period
activate P
P -> DB : 1.2.2.1.4.1.4.1.2. Find crop for selected pond and period
activate DB
DB -->> P : 1.2.2.1.4.1.4.1.3. Selected crop or none
deactivate DB
P -->> S : 1.2.2.1.4.1.4.1.4. Selected crop or none
deactivate P
end
end
end
end
deactivate S
' Source references:
' backend/src/modules/crops/crops.service.ts:1730 getGrowthTrajectory90d
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
