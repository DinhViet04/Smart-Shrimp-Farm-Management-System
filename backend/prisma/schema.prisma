// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  TECHNICIAN
  ADMIN
  FARM_MANAGER
}

enum HealthStatus {
  GOOD
  WARNING
  DANGER
}

enum CropStatus {
  ACTIVE
  HARVESTED
  FAILED
}

enum ShrimpHealthStatus {
  NORMAL
  LETHARGIC
  EDGE_GATHERING
  LOSS_OF_APPETITE
}

enum ShrimpHealthSeverity {
  NORMAL
  MILD
  MODERATE
  SEVERE
}

enum NotificationLevel {
  INFO
  WARNING
  DANGER
}

enum IncidentStatus {
  OPEN
  TREATING
  RESOLVED
}

enum IncidentEventType {
  REPORTED
  ASSIGNED
  STARTED
  TREATMENT
  RESOLVED
  REOPENED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String?
  fullName            String
  phone               String?
  address             String?
  avatarUrl           String?
  role                Role                 @default(FARMER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  farms               Farm[]
  farmStaff           FarmStaff[]
  googleId            String?              @unique
  waterQualityRecords  WaterQualityRecord[]
  inventoryUsageLogs   InventoryUsageLog[]
  shrimpHealthRecords  ShrimpHealthRecord[]
  feedingLogs          FeedingLog[]
  assignedIncidents    Incident[]                @relation("IncidentAssignee")
  reportedIncidents    Incident[]                @relation("IncidentReporter")
  incidentUpdates      IncidentTreatmentUpdate[] @relation("IncidentUpdateAuthor")

  @@map("users")
}

model Farm {
  id          String      @id @default(uuid())
  name        String      @unique
  location    String?
  address     String
  area        Float
  description String?
  status      String      @default("ACTIVE")
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id])
  ponds               Pond[]
  inventories         Inventory[]
  suppliers           Supplier[]
  staff               FarmStaff[]
  shrimpHealthRecords ShrimpHealthRecord[]
  notifications       Notification[]
  feedingLogs         FeedingLog[]
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("farms")
}

model FarmStaff {
  id         String   @id @default(uuid())
  farmId     String   @map("farm_id")
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  isActive   Boolean  @default(true) @map("is_active")
  assignedAt DateTime @default(now()) @map("assigned_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([farmId, userId])
  @@index([userId])
  @@map("farm_staffs")
}

model Pond {
  id                  String               @id @default(uuid())
  name                String
  areaSize            Float // in square meters
  depth               Float // in meters
  farmId              String
  farm                Farm                 @relation(fields: [farmId], references: [id])
  crops               Crop[]
  waterQualityRecords WaterQualityRecord[]
  shrimpHealthRecords ShrimpHealthRecord[]
  feedingLogs         FeedingLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("ponds")
}

model Crop {
  id                 String              @id @default(uuid())
  pondId             String
  pond               Pond                @relation(fields: [pondId], references: [id])
  startDate          DateTime
  initialShrimpCount Int // T_o: Số tôm thả ban đầu
  status             CropStatus          @default(ACTIVE)
  fiveTCycles         FiveTCycle[]
  environmentRecords  EnvironmentRecord[]
  incidents           Incident[]
  shrimpHealthRecords ShrimpHealthRecord[]
  feedingLogs         FeedingLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("crops")
}

model FiveTCycle {
  id                    String                 @id @default(uuid())
  cropId                String
  crop                  Crop                   @relation(fields: [cropId], references: [id])
  startDayIndex         Int // Ngày bắt đầu vòng lặp
  endDayIndex           Int // Ngày kết thúc vòng lặp
  dailyRecords          DailyRecord[]
  sizeMeasurement       SizeMeasurement?
  feedingRecommendation FeedingRecommendation?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("five_t_cycles")
}

model DailyRecord {
  id             String       @id @default(uuid())
  cycleId        String
  cycle          FiveTCycle   @relation(fields: [cycleId], references: [id])
  recordDate     DateTime
  dayIndex       Int // Ngày nuôi thứ mấy (1, 2, 3...)
  actualFeedKg   Float // Lượng thức ăn thực tế (Food_i)
  mortalityCount Int // Số tôm hao
  healthStatus   HealthStatus
  waterTemp      Float // Nhiệt độ nước để hiệu chỉnh lượng ăn
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([cycleId, recordDate])
  @@map("daily_records")
}

model SizeMeasurement {
  id                  String     @id @default(uuid())
  cycleId             String     @unique
  cycle               FiveTCycle @relation(fields: [cycleId], references: [id])
  measurementDate     DateTime
  dayIndex            Int // Phải chia hết cho 5 theo quy trình 5T
  sampleWeightGram    Float // G_m: Trọng lượng mẫu
  shrimpCountInSample Int // N_đ: Số tôm đếm được
  calculatedSize      Float // Size_m = N_đ / (G_m / 1000)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("size_measurements")
}

model FeedingRecommendation {
  id                  String     @id @default(uuid())
  cycleId             String     @unique
  cycle               FiveTCycle @relation(fields: [cycleId], references: [id])
  recommendedFeedKg   Float[] // Mảng 5 phần tử: Lượng thức ăn đề xuất 5 ngày tới
  adjustmentReasoning String? // Lý do hiệu chỉnh (ví dụ: "Giảm 10% do nhiệt độ thấp")
  applied             Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("feeding_recommendations")
}

model EnvironmentRecord {
  id         String   @id @default(uuid())
  cropId     String
  crop       Crop     @relation(fields: [cropId], references: [id])
  recordDate DateTime @default(now())
  ph         Float?
  do         Float? // Dissolved Oxygen
  alkalinity Float? // Độ kiềm
  nh3        Float?
  no2        Float?
  salinity   Float? // Độ mặn
  createdAt  DateTime @default(now())

  @@map("environment_records")
}

model Incident {
  id           String         @id @default(uuid())
  cropId       String
  crop         Crop           @relation(fields: [cropId], references: [id])
  title        String
  description  String
  treatment    String?
  status       IncidentStatus @default(OPEN)
  reporterId   String?
  reporter     User?          @relation("IncidentReporter", fields: [reporterId], references: [id])
  assignedToId String?
  assignedTo   User?          @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  startedAt    DateTime?
  resolvedAt   DateTime?
  updates      IncidentTreatmentUpdate[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([cropId, status])
  @@index([assignedToId, status])
  @@index([reporterId])

  @@map("incidents")
}

model IncidentTreatmentUpdate {
  id          String         @id @default(uuid())
  incidentId  String
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation("IncidentUpdateAuthor", fields: [authorId], references: [id])
  treatment   String
  observation String?
  result      String?
  status      IncidentStatus
  eventType   IncidentEventType @default(TREATMENT)
  createdAt   DateTime       @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_treatment_updates")
}

/// Stores periodic water quality measurements for a pond.
/// Used by: Water Quality History, Trend Analysis, Environmental Warning, AI Analysis.
model WaterQualityRecord {
  id              String   @id @default(uuid())
  pondId          String
  pond            Pond     @relation(fields: [pondId], references: [id])
  recordTime      DateTime
  temperature     Decimal  @db.Decimal(5, 2)
  ph              Decimal  @db.Decimal(4, 2)
  dissolvedOxygen Decimal  @db.Decimal(5, 2)
  salinity        Decimal  @db.Decimal(5, 2)
  alkalinity      Decimal  @db.Decimal(6, 2)
  nh3             Decimal  @db.Decimal(6, 3)
  no2             Decimal  @default(0) @db.Decimal(6, 3)
  h2s             Decimal? @db.Decimal(6, 3)
  transparency    Decimal  @default(35) @db.Decimal(5, 2)
  waterColor      String?
  note            String?
  weatherData     Json?
  createdBy       String
  creator         User     @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([pondId, recordTime])
  @@map("water_quality_records")
}

model Standard5T {
  id         Int      @id @default(autoincrement())
  dayMark    Int      @unique // 20, 35, 45, 60...
  targetSize Float // e.g. < 1000
  targetFcr  Float // e.g. < 1.0
  createdAt  DateTime @default(now())

  @@map("standard_5t")
}

enum InventoryCategory {
  FEED
  MEDICINE
  CHEMICAL
}

model Inventory {
  id           String            @id @default(uuid())
  itemName     String            @map("item_name")
  category     InventoryCategory
  quantity     Float             @default(0)
  unit         String
  packageType  String?           @map("package_type")
  packageQty   Float?            @map("package_qty")
  weightPerPkg Float?            @map("weight_per_pkg")
  minThreshold Float             @default(0) @map("min_threshold")
  supplierName String?           @map("supplier")
  description  String?
  imageUrl     String?           @map("image_url")
  shape        String?
  sizeSpec     String?           @map("size_spec")

  farmId     String    @map("farm_id")
  farm       Farm      @relation(fields: [farmId], references: [id])
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  usageLogs InventoryUsageLog[]
  feedingLogs FeedingLog[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([itemName, farmId])
  @@map("inventories")
}

model Supplier {
  id      String  @id @default(uuid())
  name    String
  phone   String?
  email   String?
  address String?
  note    String?

  farmId      String      @map("farm_id")
  farm        Farm        @relation(fields: [farmId], references: [id])
  inventories Inventory[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([name, farmId])
  @@map("suppliers")
}

model InventoryUsageLog {
  id           String    @id @default(uuid())
  inventoryId  String    @map("inventory_id")
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  quantityUsed Float     @map("quantity_used")
  usageDate    DateTime  @default(now()) @map("usage_date")
  notes        String?
  createdBy    String?   @map("created_by")
  creator      User?     @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_usage_logs")
}

/// Stores shrimp health observations recorded by technicians or farm owners.
/// Used by: FE-21 Record Shrimp Health Status.
model ShrimpHealthRecord {
  id                 String               @id @default(uuid())
  farmId             String               @map("farm_id")
  farm               Farm                 @relation(fields: [farmId], references: [id])
  pondId             String               @map("pond_id")
  pond               Pond                 @relation(fields: [pondId], references: [id])
  cropId             String               @map("crop_id")
  crop               Crop                 @relation(fields: [cropId], references: [id])
  recordedBy         String               @map("recorded_by")
  recorder           User                 @relation(fields: [recordedBy], references: [id])
  recordTime         DateTime             @map("record_time")
  healthStatus       ShrimpHealthStatus   @map("health_status")
  severity           ShrimpHealthSeverity
  affectedPercentage Float                @map("affected_percentage")
  note               String?              @db.VarChar(500)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([pondId, cropId, recordTime])
  @@map("shrimp_health_records")
}

/// Lightweight notification model for system alerts.
model Notification {
  id        String            @id @default(uuid())
  farmId    String            @map("farm_id")
  farm      Farm              @relation(fields: [farmId], references: [id])
  pondId    String?           @map("pond_id")
  level     NotificationLevel
  title     String
  message   String
  isRead    Boolean           @default(false) @map("is_read")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([farmId, isRead])
  @@map("notifications")
}

enum FeedingSession {
  SESSION_1
  SESSION_2
  SESSION_3
  SESSION_4
  SESSION_5
  SESSION_6
  SESSION_7
}

enum FeedingMethod {
  MANUAL
  AUTO
}

enum FeedingStatus {
  COMPLETED
  SKIPPED
  DELAYED
}

/// Stores daily feeding activity logs for ponds and crops.
/// Used by FE-19: Record Daily Feed Consumption.
model FeedingLog {
  id            String         @id @default(uuid())
  farmId        String         @map("farm_id")
  farm          Farm           @relation(fields: [farmId], references: [id])
  pondId        String         @map("pond_id")
  pond          Pond           @relation(fields: [pondId], references: [id])
  cropId        String         @map("crop_id")
  crop          Crop           @relation(fields: [cropId], references: [id])
  feedProductId String         @map("feed_product_id")
  feedProduct   Inventory      @relation(fields: [feedProductId], references: [id])
  feedingDate   DateTime       @map("feeding_date") @db.Date
  feedingSession FeedingSession @map("feeding_session")
  feedingTime   String         @map("feeding_time")
  feedAmount    Decimal        @map("feed_amount") @db.Decimal(8, 2)
  feedingMethod FeedingMethod  @map("feeding_method")
  feedingStatus FeedingStatus  @map("feeding_status")
  note          String?        @db.VarChar(500)
  createdBy     String         @map("created_by")
  creator       User           @relation(fields: [createdBy], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([farmId, pondId, cropId, feedingDate, feedingSession])
  @@index([pondId, cropId, feedingDate])
  @@map("feeding_logs")
}
