@startuml
' Report 4: supporting interaction
title FE-30-HISTORY - View inventory usage history
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "InventoryController" as C
participant "InventoryService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. View material usage history
activate UI
UI -> C : 2. View material usage history
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. View material usage history
activate S
S -> FA : 5. Find accessible farms
activate FA
FA -->> S : 6. Accessible farms
deactivate FA
opt 6.1 Farm selected
' ref-target: FARM-SCOPE-CHECK
ref over S : 6.1.1. Check selected farm access\n(FARM-SCOPE-CHECK)
end
alt 6.2 Selected farm access denied
S -->> C : 6.2.1. Access denied
else else
S -> P : 7. Load filtered import and usage records
activate P
P -> DB : 8. Load filtered import and usage records
activate DB
DB -->> P : 9. Material movement history
deactivate DB
P -->> S : 10. Material movement history
deactivate P
S -->> C : 11. Usage history
end
deactivate S
C -->> UI : 12. Return result or error
end
deactivate C
UI -->> U : 13. Show result or error
deactivate UI
' Source references:
' backend/src/modules/inventory/inventory.controller.ts:25 InventoryController
' backend/src/modules/inventory/inventory.service.ts:274 findUsageLogs
' backend/src/modules/farm-access/farm-access.service.ts:13 getAccessibleFarmIds
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
