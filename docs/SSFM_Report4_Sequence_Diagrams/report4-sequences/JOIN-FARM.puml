@startuml
' Report 4: supporting interaction
title JOIN-FARM - Join a farm through an invitation
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "AuthService" as S
participant "JwtService" as JWT
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
opt 1.1 Invitation not yet verified by the caller
S -> JWT : 1.1.1. Verify invitation for this account
activate JWT
JWT -->> S : 1.1.2. Valid or invalid invitation
deactivate JWT
end
end
opt 1.2 Invitation valid
group 1.2.1. Evaluate conditions
opt 1.2.1.1 Sign-in path and invited role differs; account is not Admin
S -> P : 1.2.1.1.1. Update invited user role
activate P
P -> DB : 1.2.1.1.2. Update invited user role
activate DB
DB -->> P : 1.2.1.1.3. User role aligned
deactivate DB
P -->> S : 1.2.1.1.4. User role aligned
deactivate P
end
end
S -> P : 1.2.2. Load invited farm
activate P
P -> DB : 1.2.3. Load invited farm
activate DB
DB -->> P : 1.2.4. Farm or none
deactivate DB
P -->> S : 1.2.5. Farm or none
deactivate P
opt 1.2.5.1 Farm exists
S -> P : 1.2.5.1.1. Load previous assignment
activate P
P -> DB : 1.2.5.1.2. Load previous assignment
activate DB
DB -->> P : 1.2.5.1.3. Previous farm membership
deactivate DB
P -->> S : 1.2.5.1.4. Previous farm membership
deactivate P
S -> P : 1.2.5.1.5. Activate or create farm assignment
activate P
P -> DB : 1.2.5.1.6. Activate or create farm assignment
activate DB
DB -->> P : 1.2.5.1.7. Active membership
deactivate DB
P -->> S : 1.2.5.1.8. Active membership
deactivate P
opt 1.2.5.1.8.1 New or reactivated membership
S -> N : 1.2.5.1.8.1.1. Notify the joining user
activate N
N -->> S : 1.2.5.1.8.1.2. Notification result
deactivate N
opt 1.2.5.1.8.1.2.1 Owner differs from joining user
S -> N : 1.2.5.1.8.1.2.1.1. Notify farm owner
activate N
N -->> S : 1.2.5.1.8.1.2.1.2. Notification result
deactivate N
end
end
end
end
deactivate S
' Source references:
' backend/src/modules/auth/auth.service.ts:35 register
' backend/src/modules/auth/auth.service.ts:173 login
' backend/src/modules/auth/auth.service.ts:298 loginWithGoogle
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/notifications/notifications.service.ts:31 createFarmJoinNotification
' backend/src/modules/notifications/notifications.service.ts:129 createStaffJoinedNotification
@enduml
