@startuml
' Report 4: supporting interaction
title HEALTH-FILTERS - Select shrimp health history scope
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "ShrimpHealthService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate S
group 1. Evaluate conditions
alt 1.1 Pond selected
S -> P : 1.1.1. Load pond
activate P
P -> DB : 1.1.2. Load pond
activate DB
DB -->> P : 1.1.3. Pond or none
deactivate DB
P -->> S : 1.1.4. Pond or none
deactivate P
opt 1.1.4.1 Pond exists
S -> FA : 1.1.4.1.1. Check farm access
activate FA
FA -->> S : 1.1.4.1.2. Allowed or denied
deactivate FA
end
else 1.2 Farm selected without pond
S -> P : 1.2.1. Load farm
activate P
P -> DB : 1.2.2. Load farm
activate DB
DB -->> P : 1.2.3. Farm or none
deactivate DB
P -->> S : 1.2.4. Farm or none
deactivate P
opt 1.2.4.1 Farm exists
S -> FA : 1.2.4.1.1. Check farm access
activate FA
FA -->> S : 1.2.4.1.2. Allowed or denied
deactivate FA
end
else 1.3 No specific scope
note over S
Use the accessible farm IDs already loaded.
end note
end
end
deactivate S
' Source references:
' backend/src/modules/shrimp-health/shrimp-health.service.ts:211 findHistory
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
