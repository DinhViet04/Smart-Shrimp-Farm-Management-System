@startuml
' Report 4: supporting interaction
title FE-29-CREATE - Create inventory item
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "InventoryController" as C
participant "InventoryService" as S
participant "FarmAccessService" as FA
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
caption Existing + proposed extension - target design, not a claim of complete implementation
U -> UI : 1. Submit inventory item
activate UI
UI -> C : 2. Submit inventory item
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit inventory item
activate S
S -> FA : 5. Check farm management rights
activate FA
FA -->> S : 6. Allowed or denied
deactivate FA
alt 6.1 Access denied
S -->> C : 6.1.1. Access denied
else else
opt 6.2 Supplier selected
S -> P : 6.2.1. Check supplier belongs to farm
activate P
P -> DB : 6.2.2. Check supplier belongs to farm
activate DB
DB -->> P : 6.2.3. Supplier check
deactivate DB
P -->> S : 6.2.4. Supplier check
deactivate P
end
S -> P : 7. Check item name
activate P
P -> DB : 8. Check item name
activate DB
DB -->> P : 9. Duplicate item or none
deactivate DB
P -->> S : 10. Duplicate item or none
deactivate P
alt 10.1 Supplier invalid or item name already used
S -->> C : 10.1.1. Inventory item rejected
else else
S -> P : 11. Save inventory and initial stock log atomically
activate P
P -> DB : 12. Save inventory and initial stock log atomically
activate DB
DB -->> P : 13. Inventory item
deactivate DB
P -->> S : 14. Inventory item
deactivate P
note over S
Proposed extension: Automatic low-stock alert.
end note
opt 14.1 Stock at or below threshold
S -> N : 14.1.1. Notify responsible users of low stock
activate N
N -->> S : 14.1.2. Notification result
deactivate N
end
S -->> C : 15. New inventory item
end
end
deactivate S
C -->> UI : 16. Return result or error
end
deactivate C
UI -->> U : 17. Show result or error
deactivate UI
' Source references:
' backend/src/modules/inventory/inventory.controller.ts:25 InventoryController
' backend/src/modules/inventory/inventory.service.ts:24 create
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
