@startuml
' Report 4: supporting interaction
title FE-29-UPDATE - Update inventory item and threshold
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "InventoryController" as C
participant "InventoryService" as S
participant "FarmAccessService" as FA
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
caption Existing + proposed extension - target design, not a claim of complete implementation
U -> UI : 1. Submit inventory changes
activate UI
UI -> C : 2. Submit inventory changes
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit inventory changes
activate S
S -> P : 5. Load inventory item
activate P
P -> DB : 6. Load inventory item
activate DB
DB -->> P : 7. Item or none
deactivate DB
P -->> S : 8. Item or none
deactivate P
alt 8.1 Item not found
S -->> C : 8.1.1. Item not found
else else
S -> FA : 9. Check farm management rights
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
opt 10.2 Destination farm differs
' ref-target: MANAGE-SCOPE-CHECK
ref over S : 10.2.1. Check destination farm management rights\n(MANAGE-SCOPE-CHECK)
end
alt 10.3 Destination farm access denied
S -->> C : 10.3.1. Access denied
else else
S -> P : 11. Check supplier and duplicate name
activate P
P -> DB : 12. Check supplier and duplicate name
activate DB
DB -->> P : 13. Supplier and name checks
deactivate DB
P -->> S : 14. Supplier and name checks
deactivate P
alt 14.1 Supplier invalid or duplicate name
S -->> C : 14.1.1. Inventory changes rejected
else else
S -> P : 15. Save inventory and threshold
activate P
P -> DB : 16. Save inventory and threshold
activate DB
DB -->> P : 17. Updated inventory
deactivate DB
P -->> S : 18. Updated inventory
deactivate P
note over S
Proposed extension: Automatic low-stock alert.
end note
opt 18.1 Stock at or below threshold
S -> N : 18.1.1. Notify responsible users of low stock
activate N
N -->> S : 18.1.2. Notification result
deactivate N
end
S -->> C : 19. Updated inventory item
end
end
end
end
deactivate S
C -->> UI : 20. Return result or error
end
deactivate C
UI -->> U : 21. Show result or error
deactivate UI
' Source references:
' backend/src/modules/inventory/inventory.controller.ts:25 InventoryController
' backend/src/modules/inventory/inventory.service.ts:542 update
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:54 assertCanManageFarm
@enduml
