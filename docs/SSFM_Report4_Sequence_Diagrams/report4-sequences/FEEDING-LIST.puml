@startuml
' Report 4: supporting interaction
title FEEDING-LIST - Load grouped daily feeding records
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "SSFM Interface" as UI
participant "FeedingLogsController" as C
participant "FeedingLogsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate UI
UI -> C : 1. Load daily feeding records
activate C
' ref-target: REQUEST-CHECKS
ref over C : 2. Verify user, role and input\n(REQUEST-CHECKS)
alt 2.1 Request not allowed
C -->> UI : 2.1.1. Request rejected
else else
C -> S : 3. Load daily feeding records
activate S
S -> FA : 4. Find accessible farms
activate FA
FA -->> S : 5. Accessible farms
deactivate FA
opt 5.1 Accessible farm scope is not empty
group 5.1.1. Evaluate conditions
opt 5.1.1.1 Specific farm selected
' ref-target: FARM-SCOPE-CHECK
ref over S : 5.1.1.1.1. Check selected farm access\n(FARM-SCOPE-CHECK)
end
end
opt 5.1.1.2 Crop filter supplied
S -> P : 5.1.1.2.1. Load crop and related season IDs
activate P
P -> DB : 5.1.1.2.2. Load crop and related season IDs
activate DB
DB -->> P : 5.1.1.2.3. Season scope
deactivate DB
P -->> S : 5.1.1.2.4. Season scope
deactivate P
end
S -> P : 5.1.2. Group daily records and load sessions
activate P
P -> DB : 5.1.3. Group daily records and load sessions
activate DB
DB -->> P : 5.1.4. Daily feeding groups
deactivate DB
P -->> S : 5.1.5. Daily feeding groups
deactivate P
end
S -->> C : 6. Grouped daily logs or empty result
deactivate S
C -->> UI : 7. Return result or error
end
deactivate C
deactivate UI
' Source references:
' backend/src/modules/feeding-logs/feeding-logs.controller.ts:21 FeedingLogsController
' backend/src/modules/feeding-logs/feeding-logs.service.ts:295 findAllGrouped
' backend/src/modules/farm-access/farm-access.service.ts:13 getAccessibleFarmIds
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
