# OpenAI API Key for Chatbot RAG
OPENAI_API_KEY="your_openai_api_key_here"

# Production web origins as a JSON array. Never use "*" with credentials.
CORS_ORIGINS='["https://app.example.com"]'

# Server configuration
PORT=8000
HOST="0.0.0.0"

# Google Drive Knowledge Ingestion (Method 1)
# 1. Folder ID lấy từ URL Google Drive: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=""
# 2. File Service Account JSON (đặt tại thư mục ai-service/service_account.json)
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE="service_account.json"
# 3. Hoặc nội dung JSON Service Account dạng chuỗi (dùng cho deploy cloud nếu không muốn mount file)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""
# 4. Tự động đồng bộ tài liệu từ Drive khi AI Service khởi động (true/false)
AUTO_SYNC_DRIVE_ON_STARTUP=true

