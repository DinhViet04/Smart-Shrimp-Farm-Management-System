@startuml
' Report 4: supporting interaction
title MANAGER-SUMMARY - Load harvest performance for the manager
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "SSFM Interface" as UI
participant "CropsController" as C
participant "CropsService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate UI
UI -> C : 1. Load harvest performance
activate C
' ref-target: REQUEST-CHECKS
ref over C : 2. Verify user, role and input\n(REQUEST-CHECKS)
alt 2.1 Request not allowed
C -->> UI : 2.1.1. Request rejected
else else
C -> S : 3. Load harvest performance
activate S
alt 3.1 Year or quarter invalid
S -->> C : 3.1.1. Invalid reporting period
else else
opt 3.2 Specific farm selected
' ref-target: FARM-SCOPE-CHECK
ref over S : 3.2.1. Check selected farm access\n(FARM-SCOPE-CHECK)
end
alt 3.3 Farm access denied
S -->> C : 3.3.1. Access denied
else else
S -> FA : 4. Find accessible farms
activate FA
FA -->> S : 5. Accessible farms
deactivate FA
S -> P : 6. Load harvested crops for current and previous periods
activate P
P -> DB : 7. Load harvested crops for current and previous periods
activate DB
DB -->> P : 8. Harvested crops
deactivate DB
P -->> S : 9. Harvested crops
deactivate P
S -->> C : 10. Harvest, revenue, cost, profit and survival summary
end
end
deactivate S
C -->> UI : 11. Return result or error
end
deactivate C
deactivate UI
' Source references:
' backend/src/modules/crops/crops.controller.ts:27 CropsController
' backend/src/modules/crops/crops.service.ts:138 getManagerSummary
' backend/src/modules/farm-access/farm-access.service.ts:13 getAccessibleFarmIds
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
