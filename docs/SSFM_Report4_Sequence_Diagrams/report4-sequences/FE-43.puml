@startuml
' Report 4: 3.11.2.2
title FE-43 - Track Treatment Timeline and Update Clinical Progress
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
U -> UI : 1. Choose an action
activate UI
UI -->> U : 2. Show the selected form or view
deactivate UI
alt 2.1 View history
' ref-target: FE-43-VIEW
ref over U,UI : 2.1.1. View treatment timeline\n(FE-43-VIEW)
else 2.2 Begin treatment
' ref-target: FE-43-START
ref over U,UI : 2.2.1. Start treatment\n(FE-43-START)
else 2.3 Add clinical progress
' ref-target: FE-43-UPDATE
ref over U,UI : 2.3.1. Record treatment progress\n(FE-43-UPDATE)
else 2.4 Finish treatment
' ref-target: FE-43-RESOLVE
ref over U,UI : 2.4.1. Resolve incident\n(FE-43-RESOLVE)
else 2.5 Continue after resolution
' ref-target: FE-43-REOPEN
ref over U,UI : 2.5.1. Reopen incident\n(FE-43-REOPEN)
end
' Source references:

@enduml
