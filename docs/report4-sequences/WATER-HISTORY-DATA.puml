@startuml
' Report 4: supporting interaction
title WATER-HISTORY-DATA - Load water observations for a dashboard
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "SSFM Interface" as UI
participant "WaterQualityController" as C
participant "WaterQualityService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
activate UI
UI -> C : 1. Load water observations
activate C
' ref-target: REQUEST-CHECKS
ref over C : 2. Verify user, role and input\n(REQUEST-CHECKS)
alt 2.1 Request not allowed
C -->> UI : 2.1.1. Request rejected
else else
C -> S : 3. Load water observations
activate S
S -> FA : 4. Find accessible farms
activate FA
FA -->> S : 5. Accessible farms
deactivate FA
' ref-target: WATER-HISTORY-FILTERS
ref over S : 6. Resolve selected farming scope\n(WATER-HISTORY-FILTERS)
alt 6.1 Scope missing or access denied
S -->> C : 6.1.1. Scope rejected
else else
S -> P : 7. Load water history and total
activate P
P -> DB : 8. Load water history and total
activate DB
DB -->> P : 9. Water observations
deactivate DB
P -->> S : 10. Water observations
deactivate P
S -->> C : 11. Water history
end
deactivate S
C -->> UI : 12. Return result or error
end
deactivate C
deactivate UI
' Source references:
' backend/src/modules/water-quality/water-quality.controller.ts:23 WaterQualityController
' backend/src/modules/water-quality/water-quality.service.ts:206 findHistory
' backend/src/modules/farm-access/farm-access.service.ts:13 getAccessibleFarmIds
' backend/src/prisma/prisma.service.ts:11 PrismaService
@enduml
