@startuml
' Report 4: 3.10.2.2
title FE-39 - Retrieve Real-Time Weather and Forecast Data
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "WeatherController" as C
participant "WeatherService" as S
participant "PrismaService" as P
database "PostgreSQL" as DB
participant "Open-Meteo" as W
U -> UI : 1. View current weather
activate UI
UI -> C : 2. View current weather
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
opt 3.2 Farm selected
C -> S : 3.2.1. Start weather risk check
activate S
S -->> C : 3.2.2. Task started; not awaited
deactivate S
end
C -> S : 4. View current weather
activate S
opt 4.1 Farm selected
S -> P : 4.1.1. Load farm address
activate P
P -> DB : 4.1.2. Load farm address
activate DB
DB -->> P : 4.1.3. Farm location
deactivate DB
P -->> S : 4.1.4. Farm location
deactivate P
end
S -> W : 5. Find location and load current weather
activate W
W -->> S : 6. Weather data or error
deactivate W
alt 6.1 Weather request succeeds
note over S
Use the returned current weather.
end note
else 6.2 Weather service unavailable
note over S
Use the fixed fallback weather; it is not a live observation.
end note
end
S -->> C : 7. Current weather and short forecast advice
deactivate S
C -->> UI : 8. Return result or error
end
deactivate C
UI -->> U : 9. Show result or error
deactivate UI
' Source references:
' backend/src/modules/weather/weather.controller.ts:9 WeatherController
