activate UI
UI -> C : 13. Clear own notifications
activate C
' ref-target: REQUEST-CHECKS
ref over C : 14. Verify user, role and input\n(REQUEST-CHECKS)
alt 14.1 Request not allowed
C -->> UI : 14.1.1. Request rejected
else else
C -> S : 15. Clear own notifications
activate S
S -> P : 16. Delete own notifications
activate P
P -> DB : 17. Delete own notifications
activate DB
DB -->> P : 18. Deletion result
deactivate DB
P -->> S : 19. Deletion result
deactivate P
S -->> C : 20. Clear confirmation
deactivate S
C -->> UI : 21. Return result or error
end
deactivate C
UI -->> U : 22. Show result or error
deactivate UI
