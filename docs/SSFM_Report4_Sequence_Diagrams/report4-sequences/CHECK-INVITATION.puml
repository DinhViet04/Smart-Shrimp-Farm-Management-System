@startuml
' Report 4: supporting interaction
title CHECK-INVITATION - Validate a farm invitation
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
participant "AuthService" as S
participant "JwtService" as JWT
activate S
S -> JWT : 1. Verify invitation
activate JWT
JWT -->> S : 2. Verified invitation or invalid
deactivate JWT
alt 2.1 Invitation identity and role match
note over S
Continue with the invitation role.
end note
else 2.2 Invitation invalid
note over S
Return an invitation error; account creation does not run.
end note
end
deactivate S
' Source references:
' backend/src/modules/auth/auth.service.ts:35 register
@enduml
