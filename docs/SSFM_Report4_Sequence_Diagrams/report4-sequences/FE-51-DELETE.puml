activate S
S -> P : 5. Delete notification scoped to current user
activate P
P -> DB : 6. Delete notification scoped to current user
activate DB
DB -->> P : 7. Deletion result
deactivate DB
P -->> S : 8. Deletion result
deactivate P
S -->> C : 9. Deletion confirmation
deactivate S
C -->> UI : 10. Return result or error
end
deactivate C
UI -->> U : 11. Show result or error
deactivate UI
