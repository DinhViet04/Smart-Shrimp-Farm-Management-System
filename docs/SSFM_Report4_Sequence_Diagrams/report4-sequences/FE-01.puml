@startuml
' Report 4: 3.1.2.1
title FE-01 - User Registration
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "User" as U
participant "SSFM Interface" as UI
participant "AuthController" as C
participant "AuthService" as S
participant "UsersService" as US
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit registration details
activate UI
UI -> C : 2. Submit registration details
activate C
' ref-target: PUBLIC-CHECKS
ref over C : 3. Validate request\n(PUBLIC-CHECKS)
alt 3.1 Invalid request
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit registration details
activate S
opt 4.1 Invitation supplied
' ref-target: CHECK-INVITATION
ref over S : 4.1.1. Validate invitation\n(CHECK-INVITATION)
end
alt 4.2 Invitation supplied but invalid
S -->> C : 4.2.1. Invitation rejected
else else
S -> US : 5. Check whether email is registered
activate US
US -->> S : 6. Existing account or none
deactivate US
alt 6.1 Email already registered
S -->> C : 6.1.1. Email already registered
else else
S -> US : 7. Create account
activate US
US -->> S : 8. New account
deactivate US
opt 8.1 Valid invitation
' ref-target: JOIN-FARM
ref over S : 8.1.1. Join the invited farm\n(JOIN-FARM)
end
S -> P : 9. Create sign-in session
activate P
P -> DB : 10. Create sign-in session
activate DB
DB -->> P : 11. Sign-in tokens and session
deactivate DB
P -->> S : 12. Sign-in tokens and session
deactivate P
opt 12.1 No invitation
S -> N : 12.1.1. Send welcome notification
activate N
N -->> S : 12.1.2. Notification result
deactivate N
end
S -->> C : 13. Account and sign-in result
end
end
deactivate S
C -->> UI : 14. Return result or error
end
deactivate C
UI -->> U : 15. Show registration result
deactivate UI
' Source references:
' backend/src/modules/auth/auth.controller.ts:28 AuthController
' backend/src/modules/auth/auth.service.ts:35 register
' backend/src/modules/users/users.service.ts:107 findByEmail
' backend/src/modules/users/users.service.ts:142 create
' backend/src/modules/auth/auth.service.ts:820 generateTokens
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/notifications/notifications.service.ts:13 createWelcomeNotification
@enduml
