@startuml
' Report 4: supporting interaction
title FE-11-CREATE - Create farm
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm Manager" as U
participant "SSFM Interface" as UI
participant "FarmsController" as C
participant "FarmsService" as S
participant "NotificationsService" as N
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. Submit farm details
activate UI
UI -> C : 2. Submit farm details
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. Submit farm details
activate S
S -> P : 5. Check farm name
activate P
P -> DB : 6. Check farm name
activate DB
DB -->> P : 7. Matching farm or none
deactivate DB
P -->> S : 8. Matching farm or none
deactivate P
alt 8.1 Farm name already exists or owner missing
S -->> C : 8.1.1. Farm creation rejected
else else
S -> P : 9. Save farm and farming model
activate P
P -> DB : 10. Save farm and farming model
activate DB
DB -->> P : 11. New farm
deactivate DB
P -->> S : 12. New farm
deactivate P
opt 12.1 Staff selected
S -> P : 12.1.1. Load selected users and save staff assignments
activate P
P -> DB : 12.1.2. Load selected users and save staff assignments
activate DB
DB -->> P : 12.1.3. Assigned staff
deactivate DB
P -->> S : 12.1.4. Assigned staff
deactivate P
end
S -> P : 13. Load owner role
activate P
P -> DB : 14. Load owner role
activate DB
DB -->> P : 15. Farm owner
deactivate DB
P -->> S : 16. Farm owner
deactivate P
opt 16.1 Owner is a Farm Manager
S -> N : 16.1.1. Notify farm creation
activate N
N -->> S : 16.1.2. Notification result
deactivate N
end
S -->> C : 17. New farm
end
deactivate S
C -->> UI : 18. Return result or error
end
deactivate C
UI -->> U : 19. Show result or error
deactivate UI
' Source references:
' backend/src/modules/farms/farms.controller.ts:24 FarmsController
' backend/src/modules/farms/farms.service.ts:28 create
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/notifications/notifications.service.ts:167 createFarmCreatedNotification
@enduml
