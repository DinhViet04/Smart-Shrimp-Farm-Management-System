@startuml
' Report 4: 3.9.2.4
title FE-35 - Calculate and Analyze Real-Time Feed Conversion Ratio
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam ParticipantPadding 16
skinparam sequence {
 ArrowColor #202020
 LifeLineBorderColor #777777
 ParticipantBackgroundColor white
 ParticipantBorderColor #202020
 ActorBackgroundColor white
 ActorBorderColor #202020
 ActivationBackgroundColor white
 GroupBackgroundColor white
 GroupBorderColor #444444
 ReferenceBackgroundColor white
}
skinparam NoteBackgroundColor #FFFFF0
skinparam NoteBorderColor #777777
actor "Farm User" as U
participant "SSFM Interface" as UI
participant "ShrimpSizeController" as C
participant "ShrimpSizeService" as S
participant "FarmAccessService" as FA
participant "PrismaService" as P
database "PostgreSQL" as DB
U -> UI : 1. View feed conversion analysis
activate UI
UI -> C : 2. View feed conversion analysis
activate C
' ref-target: REQUEST-CHECKS
ref over C : 3. Verify user, role and input\n(REQUEST-CHECKS)
alt 3.1 Request not allowed
C -->> UI : 3.1.1. Request rejected
else else
C -> S : 4. View feed conversion analysis
activate S
S -> P : 5. Load selected pond
activate P
P -> DB : 6. Load selected pond
activate DB
DB -->> P : 7. Pond or not found
deactivate DB
P -->> S : 8. Pond or not found
deactivate P
alt 8.1 Pond not found
S -->> C : 8.1.1. Pond not found
else else
S -> FA : 9. Check farm access
activate FA
FA -->> S : 10. Allowed or denied
deactivate FA
alt 10.1 Access denied
S -->> C : 10.1.1. Access denied
else else
S -> P : 11. Load active crop
activate P
P -> DB : 12. Load active crop
activate DB
DB -->> P : 13. Active crop or none
deactivate DB
P -->> S : 14. Active crop or none
deactivate P
alt 14.1 No active crop
S -->> C : 14.1.1. Feed conversion unavailable
else else
S -> P : 15. Load biomass samples
activate P
P -> DB : 16. Load biomass samples
activate DB
DB -->> P : 17. Samples
deactivate DB
P -->> S : 18. Samples
deactivate P
alt 18.1 Biomass samples available
S -> P : 18.1.1. Load non-skipped feeding records
activate P
P -> DB : 18.1.2. Load non-skipped feeding records
activate DB
DB -->> P : 18.1.3. Feed quantities
deactivate DB
P -->> S : 18.1.4. Feed quantities
deactivate P
note over S
Compare feed used with positive biomass gain.
No positive gain gives an unavailable ratio.
end note
else 18.2 No biomass samples
note over S
Return no current ratio and an empty history.
end note
end
S -->> C : 19. Current feed conversion and history
end
end
end
deactivate S
C -->> UI : 20. Return result or error
end
deactivate C
UI -->> U : 21. Show result or error
deactivate UI
' Source references:
' backend/src/modules/shrimp-size/shrimp-size.controller.ts:19 ShrimpSizeController
' backend/src/modules/shrimp-size/shrimp-size.service.ts:451 analyzeFCR
' backend/src/prisma/prisma.service.ts:11 PrismaService
' backend/src/modules/farm-access/farm-access.service.ts:43 assertCanAccessFarm
@enduml
